+"""Ledger aggregation."""
+
+import re
+
+
+ACCOUNT = re.compile(r"[a-z][a-z0-9_]{0,15}")
+AMOUNT = re.compile(r"(0|[1-9][0-9]*)(?:\.([0-9]{1,2}))?")
+
+
+def amount_cents(value: str) -> int:
+    match = AMOUNT.fullmatch(value)
+    if match is None:
+        raise ValueError("invalid amount")
+    fraction = (match.group(2) or "").ljust(2, "0")
+    return int(match.group(1)) * 100 + int(fraction or "0")
+
+
+def summarize(lines: list[str]) -> str:
+    totals: dict[str, int] = {}
+    for raw in lines:
+        line = raw.strip(" \t\r\n")
+        if not line:
+            continue
+        fields = line.split(",")
+        if len(fields) != 3:
+            raise ValueError("invalid ledger record")
+        account, kind, amount = fields
+        if ACCOUNT.fullmatch(account) is None:
+            raise ValueError("invalid account")
+        if kind not in {"charge", "refund"}:
+            raise ValueError("unknown ledger kind")
+        cents = amount_cents(amount)
+        totals[account] = totals.get(account, 0) + (cents if kind == "charge" else -cents)
+    return "\n".join(f"{account}={totals[account]}" for account in sorted(totals))
