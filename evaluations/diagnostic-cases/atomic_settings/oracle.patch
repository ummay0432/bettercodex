+"""Apply textual updates to settings."""
+
+import re
+
+from .parser import parse_value
+
+
+KEY = re.compile(r"[a-z][a-z0-9_]{0,31}")
+
+
+def apply_updates(current: dict[str, bool | int], lines: list[str]) -> dict[str, bool | int]:
+    updates: list[tuple[str, bool | int]] = []
+    for line in lines:
+        if not line:
+            continue
+        if line.count("=") != 1:
+            raise ValueError("invalid setting update")
+        key, raw = line.split("=")
+        if KEY.fullmatch(key) is None:
+            raise ValueError("invalid setting key")
+        updates.append((key, parse_value(raw)))
+    result = dict(current)
+    for key, value in updates:
+        result[key] = value
+    return result
